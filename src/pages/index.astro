---
import SplashLayout from '../layouts/SplashLayout.astro';
import PublicationList from '../components/PublicationList.astro';
import { getCollection } from 'astro:content';
import { author } from '../config';

const publications = (await getCollection('publications')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<SplashLayout>
  <div class="background-blob"></div>

  <div class="hero-container">
    <div class="hero-content">
      <div class="hero-image">
        <img src={`/images/${author.avatar}`} alt="Mei Yoshikawa" class="hero-avatar" />
      </div>
      <div class="hero-text">
        <h1 class="hero-name">吉川 芽生 <span class="hero-name-en">/ Mei Yoshikawa</span></h1>
        <p class="hero-bio">Master's student at the Graduate School of Pharmaceutical Sciences, University of Tokyo. Exploring the intersection of pharmaceutical sciences, NLP, and Language Models to accelerate data-driven drug discovery.</p>
        <div class="hero-socials">
          <a href={`mailto:${author.email}`} class="hero-social-link"><i class="fas fa-envelope"></i></a>
          <a href={`https://github.com/${author.github}`} class="hero-social-link" target="_blank" rel="noopener noreferrer"><i class="fab fa-github"></i></a>
          <a href={`https://www.linkedin.com/in/${author.linkedin}`} class="hero-social-link" target="_blank" rel="noopener noreferrer"><i class="fab fa-linkedin-in"></i></a>
          <a href={`https://orcid.org/${author.orcid}`} class="hero-social-link" target="_blank" rel="noopener noreferrer"><i class="fab fa-orcid"></i></a>
          <a href={`https://researchmap.jp/${author.researchmap}`} class="hero-social-link" target="_blank" rel="noopener noreferrer"><i class="fas fa-address-card"></i></a>
        </div>
      </div>
    </div>
  </div>

  <div class="modern-content-wrapper">

    <div style="text-align: right; margin-top: -3rem; margin-bottom: 1rem; padding-right: 1rem;">
      <a href="/cv/" class="gallery-link" style="font-size: 0.95rem; font-weight: 500;"><i class="fas fa-file-alt"></i> 詳細な経歴（CV）はこちら &rarr;</a>
    </div>

    <section class="modern-section">
      <h2 class="section-title"><i class="fas fa-bullhorn"></i> News</h2>
      <div class="modern-card">
        <ul class="timeline-list">
          <li>
            <div class="timeline-date">2026/8</div>
            <div class="timeline-content">
              <span class="badge badge-poster">Conference</span> IIBMP 2026にてポスター発表を行いました。
            </div>
          </li>
          <li>
            <div class="timeline-date">2025/12</div>
            <div class="timeline-content">
              <span class="badge badge-poster">Conference</span> 第8回医薬品毒性機序研究会にて口頭発表を行いました。
            </div>
          </li>
          <li>
            <div class="timeline-date">2025/12</div>
            <div class="timeline-content">
              <span class="badge badge-oral">Publication</span> bioRxivにてプレプリント「<a href="https://doi.org/10.64898/2025.12.01.691726" target="_blank" rel="noopener noreferrer" class="hover-link">Defining and Evaluating Cell–Cell Relation Extraction from Biomedical Literature under Realistic Annotation Constraints</a>」を公開しました。
            </div>
          </li>
        </ul>
      </div>
    </section>

    <section class="modern-section">
      <h2 class="section-title"><i class="fas fa-laptop-code"></i> Skills</h2>
      <div class="modern-card tags-card">
        <span class="modern-tag"><span class="tag-part">Python</span> <span class="tag-part">(データ解析・機械学習・NLP)</span></span>
        <a href="https://www.mizuno-group.com/" target="_blank" rel="noopener noreferrer" class="modern-tag"><span class="tag-part">Web 開発</span> <span class="tag-part">(研究室ウェブサイト制作)</span></a>
        <span class="modern-tag"><span class="tag-part">GAS</span> <span class="tag-part">(業務改善)</span></span>
      </div>
    </section>

    <section class="modern-section">
      <h2 class="section-title"><i class="fas fa-microscope"></i> Interests</h2>
      <div class="modern-card tags-card">
        <span class="modern-tag">Biomedical NLP</span>
        <span class="modern-tag">Language Models</span>
        <span class="modern-tag">Bioinformatics</span>
        <span class="modern-tag">Drug Discovery</span>
      </div>
    </section>

    <section class="modern-section">
      <h2 class="section-title"><i class="fas fa-book-open"></i> Publications</h2>
      <div class="modern-card">
        <PublicationList publications={publications} />
        <div style="text-align: right; margin-top: 1rem;">
          <a href="/publications/" class="gallery-link"><i class="fas fa-images"></i> ギャラリー表示はこちら &rarr;</a>
        </div>
      </div>
    </section>

  </div>
</SplashLayout>
